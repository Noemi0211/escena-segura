# Configuración de estilo compartida. El objetivo es que el código sea
# idéntico en cualquier equipo y que las diffs sean legibles.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{docx,jpg,jpeg,png,svg,webp,pdf}]
insert_final_newline = false
trim_trailing_whitespace = false
